#! ARSN 0.2
# Ascension Foundation content schema. The Foundation puts this schema in front of every content file (its own and
# the add-ons'), so a content file only holds objects. One content file = one ARSN module: object names only have to
# be unique inside the file, the "id" fields have to be unique across the whole game (namespace:path).
#
# Concepts come from JRMCore 1.3.51 / Dragonblock C+: a power type owns its attributes, statistics and classes; races
# add percent bonuses on statistics; skills cost TP and reserve a capacity attribute (DBC: Mind); transformations
# multiply attributes while they drain energy, and mastery makes them cheaper.

# One trainable attribute (DBC: STR, DEX, CON, WIL, MND, SPI). key = lang suffix, short = 3-letter label.
@AttributeDef { key string, short string }

# One statistic computed from one attribute: ceil(per_attribute x attribute x (1 + race% + class% + skill bonus)).
# released: the shown/used value is scaled by the power release (DBC Melee, Defense, Ki Power).
# role: what the engine does with it: melee, defense, body, stamina, energy_power, energy_pool, health, speed
# ("" = display). speed: the running speed of Turbo (DBC statInc SPEED; the attribute is DBC's DEX).
@StatDef {
  key string,
  attribute int [attribute >= 0],
  per_attribute float [per_attribute >= 0.0],
  released bool: false,
  role string: ""
}

# A power type (JRMCore Pwrtyp: Natural, Ki, ...). life "vanilla" keeps the hearts (Natural), "body" makes Body the
# only life (DBC). energy "" = no energy resource, otherwise the lang suffix of the resource (e.g. "qi").
# turbo: the power type has DBC Turbo (toggle key; needs release and energy, a speed statistic for the run speed).
@PowerType {
  id! unique string,
  energy string: "",
  life string [life == "vanilla" || life == "body"],
  attributes list(AttributeDef) [len(attributes) > 0],
  stats list(StatDef),
  starting list(int) [len(starting) == len(attributes)],
  attribute_limit int [attribute_limit > 0],
  release bool: false,
  capacity_attribute int: -1,
  tp_attribute int: -1,
  passive_defense int: 20,
  turbo bool: false,
  order int: 0
}

# A class of one power type (DBC: Martial Artist, Spiritualist, Warrior). stat_bonus: percent per statistic, in the
# power type's statistic order. recovery_bonus: percent on body, energy and stamina regeneration.
@CharacterClass {
  id! unique string,
  power_type string,
  stat_bonus list(int),
  recovery_bonus list(int): [0, 0, 0],
  order int: 0
}

@StatBonus { stat string, percent int }
@StartingOverride { power_type string, values list(int) }

# What the creation wizard offers for a race. Colours are "#RRGGBB" presets; heights are percent of the normal size.
# hair: the race has hair (custom hairstyle manager); hair_colors are quick presets, the colour picker allows any.
@AppearanceOptions {
  skin_colors list(string) [len(skin_colors) > 0],
  hair bool: true,
  hair_colors list(string),
  eye_colors list(string) [len(eye_colors) > 0],
  body_types int [body_types > 0],
  min_height int [min_height > 0],
  max_height int [max_height >= min_height]
}

# A race. power_types [] = every power type. stat_bonus by statistic key (melee, defense, ...), any power type.
@Race {
  id! unique string,
  genders list(string) [len(genders) > 0],
  power_types list(string): [],
  stat_bonus list(StatBonus): [],
  starting list(StartingOverride): [],
  appearance AppearanceOptions,
  order int: 0
}

# A skill. power_type "" = any. tp_cost / capacity_cost: per level step (the last entry repeats).
# effect: what the engine does per level: energy_pool (+per_level max energy), meditation (+per_level % of max
# energy per second while charging), endurance (-per_level damage taken), recovery (+per_level body regeneration),
# dash (+per_level on the Turbo run speed, DBC Dash 0.075),
# "" = concept only (no engine effect yet). learn: "sheet" (bought in the Skills tab) or "teacher" (given by command
# or by add-on code, e.g. a master).
@SkillDef {
  id! unique string,
  power_type string: "",
  max_level int [max_level > 0],
  tp_cost list(int) [len(tp_cost) > 0],
  capacity_cost list(int): [0],
  effect string: "",
  per_level float: 0.0,
  learn string: "sheet",
  order int: 0
}

# A transformation (DBC form). previous "" = from the base form, otherwise the id of the form it ascends from.
# multipliers: one per attribute of the power type (applied to released statistics). energy_drain / stamina_drain:
# percent of the maximum per second. mastery rises by mastery_gain per second in the form up to mastery_max; at full
# mastery the drains are multiplied by (1 - mastery_relief).
@Transformation {
  id! unique string,
  power_type string,
  race string: "",
  previous string: "",
  skill string: "",
  skill_level int: 0,
  multipliers list(float),
  energy_drain float [energy_drain >= 0.0],
  stamina_drain float: 0.0,
  min_release int: 0,
  mastery_gain float: 0.01,
  mastery_max float: 100.0,
  mastery_relief float: 0.5,
  color string: "#FFFFFF",
  order int: 0
}
